---
interface Props {
  src?: string;
  alt: string;
  caption: string;
  credit?: string;
}
const { src = '', alt, caption, credit = '' } = Astro.props;
---
<figure class="history-figure">
  <div class="history-figure__media">
    {src ? (
      <a href={src} target="_blank" rel="noopener noreferrer" aria-label={`查看原图：${alt}`}>
        <img src={src} alt={alt} loading="lazy" decoding="async" />
      </a>
    ) : (
      <div class="history-figure__placeholder" role="note" aria-label={`图片待补：${alt}`}>
        <span class="history-figure__glyph" aria-hidden="true">▧</span>
        <span>图片待补：{alt}</span>
      </div>
    )}
  </div>
  <figcaption>
    <span>{caption}</span>
    {credit && <small>图源：{credit}</small>}
  </figcaption>
</figure>

<style>
  .history-figure {
    margin: 2rem auto;
    max-width: 820px;
    overflow: hidden;
    border: 1px solid var(--line, rgba(226,232,240,.18));
    border-radius: 16px;
    background: rgba(30,41,59,.55);
  }
  .history-figure__media { display:grid; place-items:center; min-height:155px; }
  .history-figure__media a { width:100%; display:block; text-align:center; }
  .history-figure__media img {
    display:block; max-width:100%; max-height:650px; width:auto;
    height:auto; margin:0 auto; object-fit:contain;
  }
  .history-figure__placeholder {
    min-height:160px; width:100%; display:flex; align-items:center;
    justify-content:center; flex-direction:column; gap:.45rem;
    color:var(--muted, #cbd5e1); border:1px dashed rgba(226,232,240,.25);
    padding:1.4rem; text-align:center;
  }
  .history-figure__glyph { font-size:2rem; color:var(--accent, #f6c76f); }
  figcaption { padding:.9rem 1.15rem; font-size:.9rem; line-height:1.65; color:var(--muted,#cbd5e1); }
  figcaption small { display:block; opacity:.8; margin-top:.35rem; }
</style>
