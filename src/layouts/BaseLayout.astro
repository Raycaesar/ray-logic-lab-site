---
import '../styles/global.css';
import 'katex/dist/katex.min.css';

interface Props {
  title: string;
  description?: string;
  lang?: 'zh' | 'en';
}

const {
  title,
  description = '',
  lang = 'zh',
} = Astro.props;

const isZh = lang === 'zh';
const otherLang = isZh ? 'en' : 'zh';

const canonicalURL = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : Astro.url;
---

<!doctype html>
<html lang={isZh ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Ray Logic Lab RSS"
      href="/rss.xml"
    />
  </head>

  <body>
    <header class="site-header">
      <nav class="site-nav" aria-label={isZh ? '主导航' : 'Main navigation'}>
        <a class="site-name" href="/">Rui Zhu / 祝瑞</a>

        <div class="nav-links">
          <a href="/">{isZh ? '主页' : 'Home'}</a>

          <a href={`/${lang}/blog/`}>
            {isZh ? '博客' : 'Blog'}
          </a>

          <a
            href={`/${otherLang}/blog/`}
            aria-label={isZh ? 'Switch to English blog' : '切换到中文博客'}
          >
            {isZh ? 'EN' : '中文'}
          </a>

          <a href="/rss.xml">RSS</a>
        </div>
      </nav>
    </header>

    <main class="page-container">
      <slot />
    </main>

    <footer class="site-footer">
      <p>© 2026 Rui Zhu / Ray Logic Lab</p>
    </footer>
  </body>
</html>
