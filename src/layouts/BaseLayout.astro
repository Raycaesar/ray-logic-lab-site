---
import '../styles/global.css';
import 'katex/dist/katex.min.css';

interface Props {
  title: string;
  description?: string;
  lang?: 'zh' | 'en';
  alternateHref?: string;
}

const {
  title,
  description = '',
  lang = 'zh',
  alternateHref,
} = Astro.props;

const isZh = lang === 'zh';
const otherLang = isZh ? 'en' : 'zh';

const canonicalURL = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : Astro.url;

const languageSwitchHref =
  alternateHref ?? `/${otherLang}/blog/`;

const alternateURL = Astro.site
  ? new URL(languageSwitchHref, Astro.site)
  : new URL(languageSwitchHref, Astro.url);
---

<!doctype html>
<html lang={isZh ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="canonical" href={canonicalURL} />

    <link
      rel="alternate"
      hreflang={isZh ? 'zh-CN' : 'en'}
      href={canonicalURL}
    />

    <link
      rel="alternate"
      hreflang={otherLang === 'zh' ? 'zh-CN' : 'en'}
      href={alternateURL}
    />

    <link rel="sitemap" href="/sitemap-index.xml" />

    <link
      rel="alternate"
      type="application/rss+xml"
      title="Ray Logic Lab RSS"
      href="/rss.xml"
    />
  </head>

  <body>
    <header class="site-header">
      <nav
        class="site-nav"
        aria-label={isZh ? '主导航' : 'Main navigation'}
      >
        <a class="site-name" href="/">Rui Zhu / 祝瑞</a>

        <div class="nav-links">
          <a href="/">{isZh ? '主页' : 'Home'}</a>

          <a href={`/${lang}/blog/`}>
            {isZh ? '博客' : 'Blog'}
          </a>

          <a
            class="language-link"
            href={languageSwitchHref}
            aria-label={
              isZh
                ? 'Switch to English'
                : '切换到中文'
            }
          >
            {isZh ? 'EN' : '中文'}
          </a>

          <a href="/rss.xml">RSS</a>
        </div>
      </nav>
    </header>

    <main class="page-container">
      <slot />
    </main>

    <footer class="site-footer">
      <p>© 2026 Rui Zhu / Ray Logic Lab</p>
    </footer>
  </body>
</html>
