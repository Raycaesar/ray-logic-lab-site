---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'zh' } },
    { params: { lang: 'en' } },
  ];
}

const lang = Astro.params.lang as 'zh' | 'en';

const posts = (
  await getCollection('blog', ({ data }) => {
    return data.draft !== true && data.lang === lang;
  })
).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const pageTitle = lang === 'zh' ? '博客' : 'Blog';
const pageDescription =
  lang === 'zh'
    ? '逻辑学、中国逻辑史、逻辑教育和研究札记。'
    : 'Notes on logic, the history of logic, logic education, and related research.';
---

<BaseLayout
  title={`${pageTitle} | Ray Logic Lab`}
  description={pageDescription}
  lang={lang}
>
  <header>
    <h1>{pageTitle}</h1>
    <p>{pageDescription}</p>
  </header>

  <ul class="post-list">
    {
      posts.map((post) => (
        <li>
          <article>
            <h2>
              <a href={`/${lang}/blog/${post.data.slug}/`}>
                {post.data.title}
              </a>
            </h2>

            <p class="post-meta">
              {new Intl.DateTimeFormat(
                lang === 'zh' ? 'zh-CN' : 'en-GB',
              ).format(post.data.pubDate)}
            </p>

            <p>{post.data.description}</p>

            <div class="tags">
              {post.data.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          </article>
        </li>
      ))
    }
  </ul>
</BaseLayout>